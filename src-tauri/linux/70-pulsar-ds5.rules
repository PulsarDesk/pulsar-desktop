# Pulsar (GPLv3): DualSense passthrough on Linux.
#
# Client: SDL3's hidapi talks to the pad through hidraw, so the logged-in (seat) user needs
# the DualSense (054c:0ce6) and DualSense Edge (054c:0df2) hidraw nodes. USB pads match on
# the USB parent's ids, Bluetooth pads on the HID device name (0005:054C:0CE6.xxxx).
# `uaccess` must be tagged before 73-seat-late.rules, hence the 70- prefix.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6|0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*054C:0CE6*|*054C:0DF2*", MODE="0660", TAG+="uaccess"
