<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS entitlements for a Developer ID build that may create the host's virtual gamepad
  (pulsar-core input/mac_hid.rs, IOHIDUserDeviceCreateWithProperties).

  NOT used by default: com.apple.developer.hid.virtual.device is a restricted entitlement.
  It is only honoured with a Developer ID signature AND an embedded provisioning profile
  that grants it (requested from Apple for the dev.pulsar.app App ID); an ad-hoc or
  unsigned app that claims it is refused at launch. release.yml's "macOS signing overlay"
  step uses this file only when the APPLE_* secrets are set, and adds the team /
  application-identifier keys there. Without it the host still works: controllers fall
  back to a no-op pad and both ends get a notice (DataMsg::PadUnavailable).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.hid.virtual.device</key>
	<true/>
</dict>
</plist>
