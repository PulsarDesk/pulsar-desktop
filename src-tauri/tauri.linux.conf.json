{
	"$schema": "https://schema.tauri.app/config/2",
	"bundle": {
		"resources": ["resources/ffmpeg", "resources/pulsar-render"],
		"linux": {
			"deb": {
				"depends": ["libmpv1 | libmpv2"],
				"files": {
					"/usr/lib/udev/rules.d/70-pulsar-ds5.rules": "linux/70-pulsar-ds5.rules",
					"/usr/lib/udev/rules.d/70-pulsar-vhci.rules": "linux/70-pulsar-vhci.rules",
					"/usr/lib/modules-load.d/pulsar.conf": "linux/modules-load-pulsar.conf",
					"/usr/lib/modprobe.d/pulsar.conf": "linux/modprobe-pulsar.conf",
					"/etc/ufw/applications.d/pulsar": "linux/ufw-pulsar",
					"/usr/lib/firewalld/services/pulsar.xml": "linux/firewalld-pulsar.xml"
				},
				"postInstallScript": "linux/postinst.sh",
				"preRemoveScript": "linux/prerm.sh"
			},
			"rpm": {
				"depends": ["mpv-libs"],
				"files": {
					"/usr/lib/udev/rules.d/70-pulsar-ds5.rules": "linux/70-pulsar-ds5.rules",
					"/usr/lib/udev/rules.d/70-pulsar-vhci.rules": "linux/70-pulsar-vhci.rules",
					"/usr/lib/modules-load.d/pulsar.conf": "linux/modules-load-pulsar.conf",
					"/usr/lib/modprobe.d/pulsar.conf": "linux/modprobe-pulsar.conf",
					"/etc/ufw/applications.d/pulsar": "linux/ufw-pulsar",
					"/usr/lib/firewalld/services/pulsar.xml": "linux/firewalld-pulsar.xml"
				},
				"postInstallScript": "linux/postinst.sh",
				"preRemoveScript": "linux/prerm.sh"
			}
		}
	}
}
